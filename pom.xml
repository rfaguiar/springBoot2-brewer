<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
<modelVersion>4.0.0</modelVersion>
<groupId>com.brewer</groupId>
<artifactId>brewer-springboot</artifactId>
<version>1.0.0-SNAPSHOT</version>
<packaging>jar</packaging>
<parent>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-parent</artifactId>
<version>4.1.1</version>
<relativePath/>
</parent>
<properties>
<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
<java.version>25</java.version>
<!-- Thymeleaf -->
		<thymeleaf.version>3.1.3.RELEASE</thymeleaf.version>
<!-- Thymeleaf extras data attribute -->
<thymeleaf-extras-data-attribute.version>2.0.1</thymeleaf-extras-data-attribute.version>
<!-- Thymeleaf - Extras Spring Security -->
<thymeleaf-extras-springsecurity6.version>3.1.5.RELEASE</thymeleaf-extras-springsecurity6.version>
<!-- Jakarta EL implementation (not managed by Spring Boot's BOM) -->
<expressly.version>6.0.0</expressly.version>
<!-- thumbnailator - Gerar Thumbnail -->
<!-- https://github.com/coobird/thumbnailator -->
<thumbnailator.version>0.4.8</thumbnailator.version>
<!-- AWS SDK - S3 -->
<aws-java-sdk-s3.version>1.12.261</aws-java-sdk-s3.version>
<!-- commons-beanutils was a transitive dependency of jasperreports 6.x; jasperreports has since been removed
		     (unused in the codebase and incompatible with GraalVM native-image, see docs/spring-native-migration-plan.md),
		     but commons-beanutils is still used directly by com.brewer.validation, so it stays pinned (1.11.0 fixes CVE-2025-48734) -->
		<commons-beanutils.version>1.11.0</commons-beanutils.version>
</properties>
<dependencies>
<!-- Spring Boot 4 -->
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-webmvc</artifactId>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-validation</artifactId>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-thymeleaf</artifactId>
</dependency>
<!-- nz.net.ultraq.thymeleaf:thymeleaf-layout-dialect removed: it is implemented in Apache Groovy,
	     whose metaprogramming runtime (groovy.lang.GroovySystem / org.codehaus.groovy.reflection.ClassInfo)
	     is incompatible with GraalVM native-image (see docs/spring-native-migration-plan.md). All
	     templates were converted to the plain-Thymeleaf parameterized-fragment layout pattern
	     (th:fragment="layout(titulo, conteudo, ...)" in layout/LayoutPadrao.html and
	     layout/LayoutSimples.html, consumed via th:replace on each page's root <html> tag), which
	     needs no extra dialect/dependency. -->
<dependency>
<groupId>com.github.mxab.thymeleaf.extras</groupId>
<artifactId>thymeleaf-extras-data-attribute</artifactId>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-data-jpa</artifactId>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-mail</artifactId>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-devtools</artifactId>
<scope>runtime</scope>
</dependency>
<!-- MySQL -->
<dependency>
<groupId>com.mysql</groupId>
<artifactId>mysql-connector-j</artifactId>
<scope>runtime</scope>
</dependency>
<!-- Migracoes - Flyway -->
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-flyway</artifactId>
</dependency>
<dependency>
<groupId>org.flywaydb</groupId>
<artifactId>flyway-mysql</artifactId>
</dependency>
<!-- thumbnailator - Gerar Thumbnail -->
<dependency>
<groupId>net.coobird</groupId>
<artifactId>thumbnailator</artifactId>
<version>${thumbnailator.version}</version>
<scope>compile</scope>
</dependency>
<dependency>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-starter-security</artifactId>
</dependency>
<dependency>
<groupId>org.thymeleaf.extras</groupId>
<artifactId>thymeleaf-extras-springsecurity6</artifactId>
<version>${thymeleaf-extras-springsecurity6.version}</version>
</dependency>
<!-- AWS SDK - S3 -->
<dependency>
<groupId>com.amazonaws</groupId>
<artifactId>aws-java-sdk-s3</artifactId>
<version>${aws-java-sdk-s3.version}</version>
<exclusions>
<exclusion>
<groupId>commons-logging</groupId>
<artifactId>commons-logging</artifactId>
</exclusion>
</exclusions>
</dependency>
<!-- JasperReports dependency removed: it was unused anywhere in the codebase (no .jrxml resources,
		     no code references to net.sf.jasperreports.*) and pulled in an embedded Groovy runtime whose
		     class initializers start background threads (e.g. org.codehaus.groovy...CacheableCallSite) and
		     retain build time only ASM objects (groovyjarjarasm.asm.Type) in static state; both are
		     disallowed in a GraalVM native-image heap and would require an open ended series of
		     initialize-at-run-time / initialize-at-build-time workarounds for a dependency that is dead
		     weight. See docs/spring-native-migration-plan.md (section 8, Fase 3) for details. -->
		
<!-- Caffeine cache (replaces EhCache/JSR-107; see docs/spring-native-migration-plan.md,
	     section 8, for why EhCache was dropped: its statistics subsystem
	     (org.ehcache.shadow.org.terracotta.*) relies on a deep, effectively open-ended chain of
	     runtime reflection over its internal store/context-tree classes that GraalVM
	     native-image cannot resolve without an impractical number of hints. Caffeine has no such
	     subsystem and is Spring Boot's own recommended/officially-supported cache provider,
	     with first-class native-image support out of the box (no extra hints needed here). -->
<dependency>
<groupId>com.github.ben-manes.caffeine</groupId>
<artifactId>caffeine</artifactId>
</dependency>
<!-- JAXB (Jakarta namespace) - required by Hibernate to parse META-INF/orm.xml on Java 11+ -->
<dependency>
<groupId>jakarta.xml.bind</groupId>
<artifactId>jakarta.xml.bind-api</artifactId>
</dependency>
<dependency>
<groupId>org.glassfish.jaxb</groupId>
<artifactId>jaxb-runtime</artifactId>
</dependency>
<!-- JUnit -->
<dependency>
<groupId>junit</groupId>
<artifactId>junit</artifactId>
<version>4.12</version>
<scope>test</scope>
<exclusions>
<exclusion>
<groupId>org.hamcrest</groupId>
<artifactId>hamcrest-core</artifactId>
</exclusion>
</exclusions>
</dependency>
<dependency>
<groupId>org.hamcrest</groupId>
<artifactId>hamcrest-library</artifactId>
<version>1.3</version>
<scope>test</scope>
</dependency>
<dependency>
<groupId>org.mockito</groupId>
<artifactId>mockito-core</artifactId>
<scope>test</scope>
</dependency>
<dependency>
<groupId>org.assertj</groupId>
<artifactId>assertj-core</artifactId>
</dependency>
<dependency>
<groupId>nl.jqno.equalsverifier</groupId>
<artifactId>equalsverifier</artifactId>
<version>3.17.5</version>
<scope>test</scope>
</dependency>
<dependency>
<groupId>org.apache.commons</groupId>
<artifactId>commons-lang3</artifactId>
</dependency>
<!-- commons-beanutils - was a transitive dependency of jasperreports 6.x, dropped in jasperreports 7.x -->
<dependency>
<groupId>commons-beanutils</groupId>
<artifactId>commons-beanutils</artifactId>
<version>${commons-beanutils.version}</version>
</dependency>
<dependency>
<groupId>org.springframework</groupId>
<artifactId>spring-test</artifactId>
<scope>test</scope>
</dependency>
<!-- H2BD -->
<dependency>
<groupId>com.h2database</groupId>
<artifactId>h2</artifactId>
<scope>test</scope>
</dependency>
<dependency>
<groupId>org.glassfish.expressly</groupId>
<artifactId>expressly</artifactId>
<version>${expressly.version}</version>
<scope>test</scope>
</dependency>
</dependencies>
<build>
<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
			</plugin>
<plugin>
<groupId>org.springframework.boot</groupId>
<artifactId>spring-boot-maven-plugin</artifactId>
</plugin>
			<plugin>
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>1.19.1</version>
				<configuration>
					<targetClasses>
						<param>com.brewer.service.*</param>
						<param>com.brewer.controller.*</param>
						<param>com.brewer.model.*</param>
						<param>com.brewer.repository.helper.*</param>
						<param>com.brewer.storage.*</param>
						<param>com.brewer.session.*</param>
						<param>com.brewer.security.*</param>
						<param>com.brewer.validation.*</param>
					</targetClasses>
					<targetTests>
						<param>com.brewer.*</param>
					</targetTests>
					<outputFormats>
						<param>HTML</param>
						<param>XML</param>
					</outputFormats>
					<timestampedReports>false</timestampedReports>
					<timeoutConstant>15000</timeoutConstant>
					<timeoutFactor>3</timeoutFactor>
					<threads>4</threads>
					<exportLineCoverage>false</exportLineCoverage>
				</configuration>
			</plugin>
</plugins>
</build>
	<!--
		GraalVM Native Image status (see docs/spring-native-migration-plan.md for the full
		investigation history): the 'native'/'nativeTest' profiles are already inherited from
		spring-boot-starter-parent (mvn -Pnative spring-boot:build-image / mvn -Pnative native:compile).
		The previously identified blocker, nz.net.ultraq.thymeleaf:thymeleaf-layout-dialect
		(implemented in Apache Groovy, whose metaprogramming runtime is incompatible with GraalVM
		native-image), has been removed and all Thymeleaf templates converted to the plain-Thymeleaf
		parameterized-fragment layout pattern. See docs/spring-native-migration-plan.md for the
		result of the next native-image build attempt.
	-->
</project>
